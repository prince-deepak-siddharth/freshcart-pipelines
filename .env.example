# Copy this file to ".env" and fill in your own values:   cp .env.example .env
# ".env" is git-ignored and must NEVER be committed. ".env.example" (this file) is safe to commit.

# ---- Snowflake (Part B, FreshCart notebook) ----
SNOWFLAKE_ACCOUNT=abc12345.ap-southeast-1
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password

# ---- RabbitMQ (Part D and Bonus) ----
# Leave commented out to use a local broker (amqp://guest:guest@localhost:5672/%2F).
# Use your CloudAMQP (or other hosted broker) URL if you have one:
# RABBITMQ_URL=amqps://user:password@host/vhost
